# 카카오 책 검색 REST API 키
# https://developers.kakao.com/ → 내 애플리케이션 → REST API 키 발급
KAKAO_REST_API_KEY=your_kakao_rest_api_key_here

# 책 목차(TOC) 프록시 — Supabase Edge Function URL
# 형식: https://{PROJECT_REF}.supabase.co/functions/v1/book-toc
# 셋업: docs/SUPABASE_SETUP.md 참고
BOOK_TOC_PROXY_URL=your_supabase_function_url_here

# Supabase Auth + 데이터 백업
# 대시보드 → Settings → API → Project URL, anon public key
SUPABASE_URL=https://your-ref.supabase.co
SUPABASE_ANON_KEY=eyJhbGc...

# 알라딘 TTB(OpenAPI) 키
# 클라이언트에서 직접 호출 불가 (CORS) → Supabase 프록시의 secret으로 등록해 사용.
# 더 이상 클라이언트 .env에 둘 필요 없음 (참고용으로만 유지)
# ALADIN_TTB_KEY=your_aladin_ttb_key_here
